{
  "name": "shadow-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/src/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "brand": "node scripts/brand.mjs",
    "brand:check": "node scripts/brand.mjs --check",
    "brand:icons": "node scripts/pwa-icons.mjs && node scripts/android-assets.mjs",
    "brand:preview": "node scripts/brand.mjs --preview",
    "smoke": "node scripts/smoke.mjs",
    "presmoke": "npm run build",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "smoke:oauth": "node scripts/smoke-oauth.mjs",
    "smoke:client": "node scripts/smoke-google-client.mjs",
    "smoke:return": "node scripts/smoke-google-return.mjs",
    "presmoke:mobile": "npm run build",
    "smoke:ladder": "node scripts/ladder-check.mjs http://localhost:5173 milestones",
    "presmoke:ladder": "npm run build",
    "smoke:loader": "node scripts/loader-check.mjs",
    "presmoke:loader": "npm run build",
    "smoke:loader:exit": "node scripts/loader-exit-check.mjs",
    "presmoke:loader:exit": "npm run build",
    "smoke:canonical": "node scripts/smoke-canonical.mjs",
    "presmoke:canonical": "npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# Where the ShadowQuest data API lives.
#   unset / empty → "/api" is used and the dev/preview server proxies it to
#                   the local backend (server/, port 8788).
#   For APK / standalone production builds set the deployed URL, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# "mock" keeps the in-page Deep Work duel engine even when a base URL is set.
# The operator ledger (tasks, profile, habits, stats, ladder) ALWAYS uses the
# data API above — this flag only concerns the duel game transport.
VITE_API_MODE=mock

# ---------------------------------------------------------------------------
# Backend (server/) — see docs/BACKEND.md
# ---------------------------------------------------------------------------

# MongoDB connection. When set and reachable, all operator data lives in
# MongoDB (database below). Unset → the API persists to server/.data/db.json
# instead (a dev fallback, still real data — never mock rows).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=shadowquest

# Port the API listens on (the vite proxy expects 8788).
# PORT=8788

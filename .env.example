# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# Where the ShadowQuest data API lives.
#   unset / empty → "/api" is used and the dev/preview server proxies it to
#                   the local backend (server/, port 8788).
#   For APK / standalone production builds set the deployed URL, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# "mock" keeps the in-page Deep Work duel engine even when a base URL is set.
# The operator ledger (tasks, profile, habits, stats, ladder) ALWAYS uses the
# data API above — this flag only concerns the duel game transport.
VITE_API_MODE=mock

# ---------------------------------------------------------------------------
# Backend (server/) — see docs/BACKEND.md
# ---------------------------------------------------------------------------

# MongoDB connection. When set and reachable, all operator data lives in
# MongoDB (database below). Unset → the API persists to server/.data/db.json
# instead (a dev fallback, still real data — never mock rows).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=shadowquest

# Port the API listens on (the vite proxy expects 8788).
# PORT=8788

# ---------------------------------------------------------------------------
# Google OAuth (server/) — "Continue with Google"
# ---------------------------------------------------------------------------
#
# Real Google sign-in. Create an OAuth 2.0 Client ID of type "Web application"
# in the Google Cloud console, then paste the two halves below. All three must
# be set or the Google button is not offered at all — the gate falls back to
# email + passphrase and never invents an identity.
#
# NONE of these ever reach the browser: the secret is used in a server-to-
# server token exchange, and the frontend only ever sees a one-time handoff
# code. Do not prefix any of them with VITE_ — that would bundle them.
#
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
#
# The redirect URI, which must match one of the "Authorised redirect URIs"
# registered on that client *exactly*. Register both and set this per
# environment:
#   dev  → http://localhost:5173/api/v1/auth/google/callback
#   prod → https://api.your-domain.com/v1/auth/google/callback
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
#
# Where the backend is allowed to send the browser after a sign-in
# (comma-separated origins). This is an allowlist, not a hint: an origin that
# is not listed is refused, so nobody can bounce a session handoff to a host
# they control. Unset → localhost only, which is safe but breaks production.
# SQ_APP_ORIGIN=https://your-domain.com

# ---------------------------------------------------------------------------
# Security (server/) — see docs/SECURITY.md
# ---------------------------------------------------------------------------

# The control panel opens only for these addresses, and only after the PIN
# is presented. Both must be set for the admin surface to exist at all —
# left unset, every admin route answers 403.
# ADMIN_EMAILS=you@your-domain.com
# ADMIN_PIN=use-at-least-8-characters

# Hard cap on registered operators. Sign-up beyond this answers 503.
# Default: 1000.
# SQ_MAX_USERS=1000

# Lock CORS to an explicit origin allowlist (comma-separated). Unset → open
# CORS (dev default). Set this in production.
# SQ_CORS_ORIGIN=https://your-domain.com

# Trust the first proxy hop for client IPs (needed for honest rate limits
# behind a reverse proxy / platform proxy). Off by default.
# SQ_TRUST_PROXY=1

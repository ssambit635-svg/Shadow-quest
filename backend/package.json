{
  "name": "liferpg-backend",
  "version": "1.0.0",
  "description": "LifeRPG — backend API that turns real-life productivity into an RPG. Authoritative game logic, JWT auth, MongoDB.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seedDatabase.js",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "liferpg",
    "rpg",
    "productivity",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
